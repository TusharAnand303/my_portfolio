rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // The live portfolio is the only document that anonymous visitors can get.
    // Collection listing is deliberately disabled for public clients.
    match /portfolio/{documentId} {
      allow get: if documentId == 'published' || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && documentId != 'published';
    }

    // Create the first admin document from the Firebase console. Client apps
    // can read only their own status and can never grant or change access.
    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
